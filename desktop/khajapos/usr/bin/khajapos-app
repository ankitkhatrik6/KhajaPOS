        def _on_decide_policy(self, webview, decision, decision_type):
            """Keep new-window requests inside this view.

            JS `window.open()` and any target=_blank click that slips past
            the injected user script arrive here as a NEW_WINDOW_ACTION.
            We ignore WebKit's new-window machinery (whose WindowFeatures
            handling crashes on modern WebKitGTK) and simply load the
            target URI in the current view, so A4/receipt pages and their
            Print buttons stay inside the app.
            """
            try:
                if decision_type == WebKit2.PolicyDecisionType.NEW_WINDOW_ACTION:
                    nav = decision.get_navigation_action()
                    request = nav.get_request() if nav is not None else None
                    uri = request.get_uri() if request is not None else None
                    if uri:
                        decision.ignore()
                        GLib.idle_add(self._load_same_view, uri)
                        return True
            except Exception:
                pass
            return False

        def _load_same_view(self, uri):
            if self.webview is not None:
                self.webview.load_uri(uri)
            return False

        def _on_web_print(self, webview, print_operation):
            """Handle WebKit's native print signal (window.print() path).

            The page's window.print() (A4 invoice / 80 mm receipt buttons)
            lands here with the print operation WebKit already created for
            this job. We start it asynchronously — creating a second
            operation or calling the synchronous run_dialog() here would
            re-enter GTK inside WebKit's signal emission and crash the app
            on modern WebKitGTK. Returning True consumes WebKit's default
            (often broken) handling.
            """
            try:
                self._start_print_operation(print_operation)
            except Exception:
                pass
            return True

        def _on_script_dialog(self, webview, dialog):
            """Route window.print() calls from the web UI to print workflow.

            WebKit2GTK has no built-in JS print preview, so this maps any
            `window.print()` button (A4 invoice, 80 mm receipt, reports) to
            the same tested desktop print dialog used by File > Print.
            """
            try:
                dialog_type = dialog.get_dialog_type()
                if dialog_type == WebKit2.ScriptDialogType.BEFORE_UNLOAD_CONFIRM:
                    return False
                if dialog_type == WebKit2.ScriptDialogType.CONFIRM:
                    if "print" in (dialog.get_message() or "").lower():
                        # JS confirm(Print?)-style hooks: approve, then print
                        # the already-rendered page through the tested path.
                        if not self._pending_print:
                            self._pending_print = True
                            dialog.confirm_set_confirmed(True)
                            GLib.idle_add(self._run_pending_print)
                        else:
                            dialog.confirm_set_confirmed(True)
                        return True
                    return False
                # alert/beforeunload/prompt text: if it looks like a print
                # request, print through the same menu-driven dialog instead
                # of showing a page popup.
                message = (dialog.get_message() or "").lower()
                if "print" in message or "receipt" in message or "invoice" in message:
                    if not self._pending_print:
                        self._pending_print = True
                        GLib.idle_add(self._run_pending_print)
                    try:
                        if dialog_type == WebKit2.ScriptDialogType.ALERT:
                            dialog.close()
                    except Exception:
                        pass
                    return True
            except Exception:
                pass
            return False

        def _run_pending_print(self):
            self._pending_print = False
            self._print_current()
            return False

# Build and show the main window, then run the GTK main loop.  The loop
    # keeps the application open until the user closes it (Quit / Ctrl+Q /
    # Alt+F4); _poll_startup() drives the startup sequence from the loop.
    KhajaPOSWindow()
    Gtk.main()
    return 0


# --------------------------------------------------------------------------
# Entry point
# --------------------------------------------------------------------------
def _open_in_browser():
    for browser in ("xdg-open", "sensible-browser", "x-www-browser"):
        if subprocess.run(["sh", "-c", "command -v %s >/dev/null 2>&1" % browser],
                          capture_output=True).returncode == 0:
            subprocess.Popen([browser, URL])
            return
    print("KhajaPOS is ready at %s" % URL)


def main() -> int:
    args = sys.argv[1:]
    if "--help" in args or "-h" in args:
        print(__doc__)
        return 0

    # The window needs the GTK/WebKit2 stack; otherwise use the browser.
    try:
        return run_gui()
    except Exception as exc:  # noqa: BLE001 - degraded mode is intended
        print(
            "KhajaPOS desktop window could not start (%s).\n"
            "Opening the default browser instead..." % exc,
            file=sys.stderr,
        )
        _open_in_browser()
        return 0


if __name__ == "__main__":
    sys.exit(main())