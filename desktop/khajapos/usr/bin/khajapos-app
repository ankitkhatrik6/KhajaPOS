#!/usr/bin/env python3
"""
KhajaPOS Desktop App
--------------------
Native desktop window for the KhajaPOS Restaurant POS / Billing system.
The local server runs entirely on this machine; the whole user interface is
rendered inside this window (no browser required).

Usage:
  khajapos-app                Open the desktop app
  khajapos-app --kiosk        Open fullscreen (ideal for a POS terminal)
  khajapos-app --browse       Fall back to the default browser
"""

import os
import re
import shutil
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request

URL = "http://127.0.0.1:3000"
SERVICE = "khajapos.service"
APP_VERSION = "2.2.3"
ICON_PATHS = (
    "/usr/share/pixmaps/khajapos.png",
    "/usr/share/icons/hicolor/512x512/apps/khajapos.png",
)

POLL_DELAY_MS = 600
STARTUP_TIMEOUT_S = 90


# --------------------------------------------------------------------------
# Local server helpers
# --------------------------------------------------------------------------
def _open_in_browser_available() -> bool:
    return any(
        shutil.which(browser) is not None
        for browser in ("xdg-open", "sensible-browser", "x-www-browser")
    )


def _open_in_browser_uri(uri: str) -> bool:
    for browser in ("xdg-open", "sensible-browser", "x-www-browser"):
        if shutil.which(browser) is None:
            continue
        try:
            subprocess.Popen([browser, uri])
            return True
        except Exception:
            continue
    print("KhajaPOS is ready at %s" % uri)
    return False


def server_up() -> bool:
    """Return True when the KhajaPOS web server answers on its base URL.

    Any HTTP response (200, 302, 404, ...) proves the server is listening, so
    a link-check only has to see the socket respond. We do not rely on the
    framework's "/up" health endpoint here.
    """
    try:
        with urllib.request.urlopen(URL, timeout=2) as resp:
            return resp.status < 500
    except urllib.error.HTTPError as err:
        # A 4xx status is still a live server answering requests.
        return err.code < 500
    except Exception:
        return False


def _systemctl_active(unit: str) -> bool:
    try:
        return subprocess.run(
            ["systemctl", "is-active", "--quiet", unit]
        ).returncode == 0
    except Exception:
        return False


def _systemctl_start(unit: str) -> bool:
    """Try as the user, then fall back to a graphical pkexec password prompt."""
    try:
        if subprocess.run(
            ["systemctl", "start", "--quiet", unit], capture_output=True
        ).returncode == 0:
            return True
        return subprocess.run(
            ["pkexec", "systemctl", "start", "--quiet", unit], capture_output=True
        ).returncode == 0
    except Exception:
        return False


def ensure_services() -> None:
    """Best effort: start the database and the KhajaPOS service if needed."""
    # 1) Database server (mariadb or mysql)
    try:
        units = subprocess.run(
            ["systemctl", "list-unit-files"], capture_output=True, text=True
        ).stdout
    except Exception:
        units = ""
    for db in ("mariadb", "mysql"):
        if db + ".service" in units and not _systemctl_active(db + ".service"):
            _systemctl_start(db + ".service")
        if db + ".service" in units:
            break

    # 2) KhajaPOS application service
    if not _systemctl_active(SERVICE):
        _systemctl_start(SERVICE)


def wait_for_server(timeout: float = STARTUP_TIMEOUT_S) -> bool:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if server_up():
            return True
        time.sleep(1)
    return server_up()


def _safe_markup(label, text):
    """Set Pango markup on a Gtk.Label, falling back to plain text.

    set_markup raises when the markup string is malformed; we never want a
    cosmetic label to take the whole app down with it.
    """
    try:
        label.set_markup(text)
    except Exception:
        label.set_text(re.sub(r"<[^>]*>", "", text))


class _Import:
    """Lazy GUI imports so the app can fall back to the browser when the
    WebKit2GTK stack is unavailable."""

    @staticmethod
    def load():
        import gi  # noqa: PLC0415

        webkit_major = None
        for ver in ("4.1", "4.0", "3.0"):
            try:
                gi.require_version("WebKit2", ver)
                webkit_major = ver
                break
            except ValueError:
                continue
        if webkit_major is None:
            raise RuntimeError("WebKit2GTK is not available")
        gi.require_version("Gtk", "3.0")
        from gi.repository import Gtk, WebKit2  # noqa: PLC0415

        return Gtk, WebKit2
# --------------------------------------------------------------------------
# Desktop window
# --------------------------------------------------------------------------
def run_gui() -> int:
    Gtk, WebKit2 = _Import.load()

    from gi.repository import Gdk, GdkPixbuf, GLib  # noqa: PLC0415

    open_in_browser = _open_in_browser  # local alias used by the window code

    class KhajaPOSWindow(Gtk.Window):
        """Main application window: menu bar + embedded KhajaPOS UI."""

        def __init__(self):
            Gtk.Window.__init__(self, title="KhajaPOS - Restaurant POS")
            self.set_default_size(1280, 820)
            self.set_position(Gtk.WindowPosition.CENTER)
            if "--kiosk" in sys.argv or "-k" in sys.argv:
                self.fullscreen()
            for icon in ICON_PATHS:
                if os.path.exists(icon):
                    try:
                        self.set_icon_from_file(icon)
                    except Exception:
                        pass
                    break

            vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            self.add(vbox)
            vbox.pack_start(self._build_menubar(), False, False, 0)

            self.stack = Gtk.Stack()
            self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
            self.stack.set_transition_duration(250)
            vbox.pack_start(self.stack, True, True, 0)

            self.stack.add_named(self._build_loading(), "loading")
            self.stack.add_named(self._build_error(), "error")
            self.stack.set_visible_child_name("loading")

            self.webview = None
            self._ensure_started = False
            self._start_check = time.monotonic()

            self._build_accelerators()
            self.connect("destroy", Gtk.main_quit)
            self.show_all()
            GLib.timeout_add(POLL_DELAY_MS, self._poll_startup)

        # ------------------------------------------------------------ helpers
        def _build_accelerators(self):
            from gi.repository import Gdk as _gdk  # noqa: PLC0415

            self.accel_group = Gtk.AccelGroup()
            self.add_accel_group(self.accel_group)
            ctrl = _gdk.ModifierType.CONTROL_MASK
            for keyval, mod, action in (
                (_gdk.KEY_r, ctrl, lambda *_: self._reload()),
                (_gdk.KEY_b, ctrl, lambda *_: open_in_browser()),
                (_gdk.KEY_p, ctrl, lambda *_: self._print_current()),
                (_gdk.KEY_q, ctrl, lambda *_: Gtk.main_quit()),
                (_gdk.KEY_F11, 0, lambda *_: self.toggle_fullscreen()),
                (_gdk.KEY_plus, 0, lambda *_: self._zoom(1)),
                (_gdk.KEY_minus, 0, lambda *_: self._zoom(-1)),
            ):
                self.accel_group.connect(
                    keyval, mod, Gtk.AccelFlags.VISIBLE, action
                )

        def _build_menubar(self):
            def submenu(label, entries):
                menu = Gtk.Menu()
                root = Gtk.MenuItem.new_with_label(label)
                root.set_submenu(menu)
                for text, callback in entries:
                    mi = Gtk.MenuItem.new_with_label(text)
                    mi.connect("activate", callback)
                    menu.append(mi)
                return root

            mb = Gtk.MenuBar()
            mb.append(submenu("_File", [
                ("Print Invoice / Receipt  (Ctrl+P)", lambda *_: self._print_current()),
                ("Reload", lambda *_: self._reload()),
                ("Open in Browser", lambda *_: open_in_browser()),
                ("Quit", lambda *_: Gtk.main_quit()),
            ]))
            mb.append(submenu("_View", [
                ("Fullscreen", lambda *_: self.toggle_fullscreen()),
                ("Zoom In", lambda *_: self._zoom(1)),
                ("Zoom Out", lambda *_: self._zoom(-1)),
            ]))
            mb.append(submenu("_Help", [
                ("About KhajaPOS", lambda *_: self._about()),
            ]))
            return mb
# ------------------------------------------------------------ screens
        def _logo_pixbuf(self, width=180, height=180):
            """Load and scale the KhajaPOS logo for the loading screen."""
            for path in ICON_PATHS:
                if os.path.exists(path):
                    try:
                        return GdkPixbuf.Pixbuf.new_from_file_at_scale(
                            path, width, height, True
                        )
                    except Exception:
                        continue
            return None

        def _build_loading(self):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            box.set_valign(Gtk.Align.CENTER)
            box.set_halign(Gtk.Align.CENTER)

            # KhajaPOS logo with a gentle pulsing effect while the server boots
            self.logo_image = Gtk.Image()
            pixbuf = self._logo_pixbuf()
            if pixbuf is not None:
                self.logo_image.set_from_pixbuf(pixbuf)
            self.logo_image.set_opacity(0.8)
            self._fade_dir = -1
            self._fade_step = 0.07

            title = Gtk.Label()
            _safe_markup(
                title, '<span size="xx-large" weight="bold">KhajaPOS</span>'
            )

            subtitle = Gtk.Label()
            _safe_markup(
                subtitle,
                '<span size="medium" color="#7c3aed">Restaurant Point of Sale, '
                "Inventory &amp; Billing System</span>",
            )

            self.spinner = Gtk.Spinner()
            self.spinner.set_size_request(36, 36)
            self.spinner.start()

            self.loading_label = Gtk.Label()
            _safe_markup(
                self.loading_label,
                "Starting the KhajaPOS local server on this machine...\n"
                '<span size="small">Your point of sale opens here in a '
                "moment.</span>",
            )

            box.pack_start(self.logo_image, False, False, 0)
            box.pack_start(title, False, False, 0)
            box.pack_start(subtitle, False, False, 0)
            box.pack_start(self.spinner, False, False, 0)
            box.pack_start(self.loading_label, False, False, 0)

            GLib.timeout_add(50, self._pulse_logo)
            return box

        def _pulse_logo(self):
            """Pulse the logo opacity while the loading screen is visible.

            Returns True to keep animating; returns False (stops the timer)
            as soon as the webview has taken over the window.
            """
            if self.stack.get_visible_child_name() != "loading":
                return False
            try:
                if self.logo_image is not None:
                    opacity = (
                        self.logo_image.get_opacity()
                        + self._fade_dir * self._fade_step
                    )
                    if opacity <= 0.45:
                        opacity = 0.45
                        self._fade_dir = 1
                    elif opacity >= 1.0:
                        opacity = 1.0
                        self._fade_dir = -1
                    self.logo_image.set_opacity(opacity)
            except Exception:
                return False
            return True

        def _build_error(self):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            box.set_valign(Gtk.Align.CENTER)
            box.set_halign(Gtk.Align.CENTER)
            label = Gtk.Label()
            _safe_markup(
                label,
                '<span size="large" weight="bold">KhajaPOS could not be '
                "started.</span>\n\n"
                "The local server did not answer. Check the status with:\n"
                '<span size="small" font_family="monospace">sudo khajapos '
                "doctor</span>",
            )
            box.pack_start(label, False, False, 0)
            buttons = Gtk.Box(spacing=10)
            retry = Gtk.Button.new_with_label("Retry")
            retry.connect("clicked", lambda *_: self._retry_clicked())
            browse = Gtk.Button.new_with_label("Open in Browser")
            browse.connect("clicked", lambda *_: open_in_browser())
            buttons.pack_start(retry, False, False, 0)
            buttons.pack_start(browse, False, False, 0)
            box.pack_start(buttons, False, False, 0)
            return box

        # ------------------------------------------------------------ logic
        def _poll_startup(self):
            if server_up():
                self._load_app()
                return False
            if not self._ensure_started and time.monotonic() - self._start_check > 2:
                self._ensure_started = True
                threading.Thread(target=ensure_services, daemon=True).start()
            if time.monotonic() - self._start_check > STARTUP_TIMEOUT_S:
                if self.spinner is not None:
                    self.spinner.stop()
                self.stack.set_visible_child_name("error")
                return False
            self.loading_label.set_text(
                "Starting the KhajaPOS local server...\n"
                "(a one-time password prompt may appear)"
            )
            return True

        def _retry_clicked(self):
            self._ensure_started = False
            self._start_check = time.monotonic()
            self.stack.set_visible_child_name("loading")
            if self.spinner is not None:
                self.spinner.start()
            self.loading_label.set_text("Retrying... please wait.")
            GLib.timeout_add(POLL_DELAY_MS, self._poll_startup)

        def _load_app(self):
            if self.spinner is not None:
                self.spinner.stop()
            if self.webview is not None:
                GLib.idle_add(self.stack.set_visible_child_name, "app")
                self.webview.reload()
                return
            # The invoice/receipt print buttons are target=_blank links. On
            # modern WebKitGTK the new-window machinery (create signal +
            # WindowFeatures handling) crashes the whole app (empty
            # std::optional<WebCore::WindowFeatures> assertion), especially
            # when a handler returns an already-realized view. We therefore
            # keep such clicks out of that machinery entirely:
            #   1. a user script rewrites target=_blank clicks into
            #      same-view navigation before WebKit sees them;
            #   2. `decide-policy` NEW_WINDOW_ACTION (JS window.open etc.)
            #      is ignored and loaded in the same view;
            #   3. NO `create` handler is installed at all - stray popups
            #      are simply blocked by WebKit's safe default.
            keep_in_app_js = (
                "(function(){"
                "document.addEventListener('click', function(e){"
                " var el = e.target;"
                " var a = el && el.closest ? el.closest('a') : null;"
                " if (a && a.getAttribute('target') === '_blank' && a.href){"
                " e.preventDefault(); e.stopPropagation();"
                " window.location.href = a.href;"
                " }"
                "}, true);"
                "})();"
            )
            ucm = WebKit2.UserContentManager()
            ucm.add_script(
                WebKit2.UserScript(
                    keep_in_app_js,
                    WebKit2.UserContentInjectedFrames.ALL_FRAMES,
                    WebKit2.UserScriptInjectionTime.END,
                    None,
                    None,
                )
            )
            web = WebKit2.WebView.new_with_user_content_manager(ucm)
            settings = web.get_settings()
            settings.set_property("enable-developer-extras", False)
            # WebKit2GTK does not surface window.print() as a browser dialog by
            # default: the call is delivered through the `print` signal and
            # (on older builds) through a modal script dialog. We handle both
            # paths so the buttons in the web UI always print.
            settings.set_allow_modal_dialogs(True)
            settings.set_enable_javascript(True)
            web.connect("load-failed", self._on_load_failed)
            web.connect("decide-policy", self._on_decide_policy)
            try:
                # Native WebKit `print` signal: raised when the page calls
                # window.print() (A4 invoice / 80 mm receipt buttons). We
                # route it into the async system print dialog.
                web.connect("print", self._on_web_print)
            except Exception:
                pass
            self._pending_print = False
            self._printing = False
            web.load_uri(URL)
            self.webview = web
            self.stack.add_named(web, "app")
            web.show()
            self.stack.set_visible_child_name("app")

        def _on_load_failed(self, *_args):
            if self.spinner is not None:
                self.spinner.stop()
            if self.webview is not None:
                self.stack.set_visible_child_name("error")

        def _reload(self):
            if self.webview is not None:
                self.webview.reload()

        def _zoom(self, direction):
            if self.webview is not None:
                self.webview.set_zoom_level(
                    self.webview.get_zoom_level() + 0.15 * direction
                )

        def toggle_fullscreen(self):
            if self.get_window().get_state() & Gdk.WindowState.FULLSCREEN:
                self.unfullscreen()
            else:
                self.fullscreen()

        def _print_current(self):
            """Print the current page with the system print dialog.

            Made crash-proof for real counter printers:

            1. WebKit2GTK's asynchronous `PrintOperation.print_()` is used.
               The older `run_dialog()` call is synchronous and spins a
               nested GTK main loop; calling it while a WebKit `print`
               signal is still being emitted re-enters GTK inside WebKit
               and segfaults the whole app (WebKitGTK >= 2.4x). `print_()`
               shows the very same system print dialog but driven by the
               normal main loop, so nothing is re-entered and the app
               stays alive.
            2. The operation honours the web templates' `@page`/
               `@media print` CSS, so A4 invoices print full-page and
               80 mm receipts print narrow on thermal printers.
            """
            if self.webview is None:
                return False
            try:
                operation = WebKit2.PrintOperation.new(self.webview)
                self._start_print_operation(operation)
            except Exception as exc:
                print(
                    "KhajaPOS: printing failed - %s" % exc, file=sys.stderr
                )
                return self._print_browser_fallback()
            return False

        def _start_print_operation(self, operation):
            """Run one WebKit print operation asynchronously.

            `print_()` presents the GTK print dialog and continues
            (printing, progress) entirely inside the regular GTK main
            loop. Errors are reported through the `failed` signal, which
            we log instead of crashing on.

            Only one print operation runs at a time: a new request while
            the dialog is open (rapid double click, autoprint + Ctrl+P)
            would otherwise stack a second dialog on top of the first.
            The `finished`/`failed` signals clear the guard again.
            """
            if getattr(self, "_printing", False):
                print(
                    "KhajaPOS: a print job is already running - ignoring the new request",
                    file=sys.stderr,
                )
                return
            try:
                if hasattr(operation, "set_show_progress"):
                    try:
                        operation.set_show_progress(True)
                    except Exception:
                        pass
                operation.connect("failed", self._on_print_failed)
                operation.connect("finished", self._on_print_finished)
                self._printing = True
                operation.print_()
            except Exception as exc:
                self._printing = False
                print(
                    "KhajaPOS: could not start printing - %s" % exc,
                    file=sys.stderr,
                )
                self._print_browser_fallback()

        def _on_print_finished(self, operation):
            """Clear the one-print-at-a-time guard when the job ends."""
            self._printing = False
            return False

        def _on_print_failed(self, operation, error):
            """Log print errors instead of letting them take the app down."""
            self._printing = False
            try:
                message = error.message if hasattr(error, "message") else error
            except Exception:
                message = error
            print(
                "KhajaPOS: print job failed - %s" % message, file=sys.stderr
            )
            return False

        def _print_browser_fallback(self):
            """Last-resort printing through the default desktop browser."""
            try:
                uri = (
                    self.webview.get_uri()
                    if self.webview is not None
                    else URL
                )
                print("KhajaPOS: using browser fallback for %s" % uri)
                if _open_in_browser_available():
                    _open_in_browser_uri(uri)
                    return True
            except Exception as exc:
                print("KhajaPOS: browser fallback failed - %s" % exc, file=sys.stderr)
            return False

        def _read_license(self):
            """Return the MIT license text shipped with the application."""
            try:
                with open("/opt/khajapos/LICENSE", encoding="utf-8") as fh:
                    return fh.read()
            except Exception:
                return (
                    "MIT License\n\n"
                    "Copyright (c) 2026 Ankit Khatri KC\n\n"
                    "Permission is hereby granted, free of charge, to any person "
                    "obtaining a copy of this software and associated documentation "
                    "files (the \"Software\"), to deal in the Software without "
                    "restriction, including without limitation the rights to use, "
                    "copy, modify, merge, publish, distribute, sublicense, and/or "
                    "sell copies of the Software.\n..."
                )

        def _about_row(self, label_text, value_text):
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            label = Gtk.Label()
            _safe_markup(label, '<span weight="bold">%s</span>' % label_text)
            label.set_xalign(0)
            label.set_size_request(150, -1)
            value = Gtk.Label()
            value.set_text(value_text)
            value.set_xalign(0)
            value.set_line_wrap(True)
            value.set_selectable(True)
            row.pack_start(label, False, False, 0)
            row.pack_start(value, True, True, 0)
            return row

        def _about(self):
            """About dialog with everything about this project.

            A custom scrollable dialog is used so the project logo stays a
            small fixed-size thumbnail and the full description, feature
            list, technical details and help remain visible.
            """
            dlg = Gtk.Dialog(
                title="About KhajaPOS",
                transient_for=self,
                modal=True,
            )
            dlg.set_default_size(660, 540)
            dlg.add_button("Close", Gtk.ResponseType.CLOSE)

            content = dlg.get_content_area()
            scrolled = Gtk.ScrolledWindow()
            scrolled.set_policy(
                Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC
            )
            scrolled.set_min_content_height(470)
            content.pack_start(scrolled, True, True, 0)

            body = Gtk.Box(
                orientation=Gtk.Orientation.VERTICAL, spacing=10
            )
            body.set_border_width(20)
            scrolled.add_with_viewport(body)

            header = Gtk.Box(
                orientation=Gtk.Orientation.HORIZONTAL, spacing=18
            )
            logo_image = Gtk.Image()
            logo_pixbuf = self._logo_pixbuf(96, 96)
            if logo_pixbuf is not None:
                logo_image.set_from_pixbuf(logo_pixbuf)
            header.pack_start(logo_image, False, False, 0)

            title_box = Gtk.Box(
                orientation=Gtk.Orientation.VERTICAL, spacing=4
            )
            name_label = Gtk.Label()
            _safe_markup(
                name_label,
                '<span size="x-large" weight="bold">KhajaPOS</span>',
            )
            name_label.set_xalign(0)
            title_box.pack_start(name_label, False, False, 0)

            version_label = Gtk.Label()
            version_label.set_text(
                "Version %s - Desktop App (Linux)" % APP_VERSION
            )
            version_label.set_xalign(0)
            title_box.pack_start(version_label, False, False, 0)

            tagline = Gtk.Label()
            _safe_markup(
                tagline,
                "Restaurant Point of Sale, Inventory and Billing System.",
            )
            tagline.set_xalign(0)
            tagline.set_line_wrap(True)
            title_box.pack_start(tagline, False, False, 0)
            header.pack_start(title_box, True, True, 0)
            body.pack_start(header, False, False, 0)

            url_label = Gtk.Label()
            _safe_markup(
                url_label,
                '<a href="https://github.com/ankitkhatrik6/KhajaPOS">'
                "https://github.com/ankitkhatrik6/KhajaPOS</a>",
            )
            url_label.set_xalign(0)
            url_label.set_line_wrap(True)
            body.pack_start(url_label, False, False, 0)

            copyright_label = Gtk.Label()
            copyright_label.set_text(
                "Copyright (c) 2026 Ankit Khatri KC - MIT License"
            )
            copyright_label.set_xalign(0)
            copyright_label.set_line_wrap(True)
            body.pack_start(copyright_label, False, False, 0)

            what = Gtk.Label()
            what.set_xalign(0)
            what.set_line_wrap(True)
            _safe_markup(
                what,
                "<b>What KhajaPOS is</b>\n"
                "KhajaPOS is a production-ready restaurant point of sale, "
                "stock management and billing platform. It gives real "
                "restaurants and cafes a fast cash counter, an accurate "
                "inventory ledger and clean VAT- and PAN-compliant receipts, "
                "all in one place. Every sale is recorded in NPR and stock "
                "moves are tracked in real time on the local server.",
            )
            body.pack_start(what, False, False, 0)

            features = Gtk.Label()
            features.set_xalign(0)
            features.set_line_wrap(True)
            _safe_markup(
                features,
                "<b>Everything this project includes</b>\n"
                "\u2022 POS billing terminal with instant item search and category filters\n"
                "\u2022 Cash and online payments with automatic change calculation\n"
                "\u2022 Raw-material inventory with low-stock alerts and stock history\n"
                "\u2022 Menu management and category organisation\n"
                "\u2022 VAT-compliant tax invoices - printable A4 and 80 mm thermal receipts\n"
