# ============================================================================
# KhajaPOS configuration file (managed by the khajapos Debian package)
# Edit with:  sudo khajapos config
#
# APP_URL is updated automatically on first install to this machine's LAN IP.
# APP_KEY and DB_PASSWORD are generated automatically on first install.
# ============================================================================
APP_NAME="KhajaPOS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3000

APP_TIMEZONE=Asia/Kathmandu
CURRENCY=NPR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restaurant_pos
DB_USERNAME=pos_user
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync