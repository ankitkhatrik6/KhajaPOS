# APP_URL: The URL where this applet is hosted.
APP_URL=http://localhost:3000

APP_NAME="Restaurant Stock & POS Nepal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

APP_TIMEZONE=Asia/Kathmandu
CURRENCY=NPR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restaurant_pos
DB_USERNAME=pos_user
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
